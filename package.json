{
  "name": "jju-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-local-dev.mjs",
    "build": "node scripts/build-publication-edition.mjs && node scripts/verify-publication-edition.mjs --skip-build && next build",
    "start": "next start",
    "lint": "eslint",
    "publication:build": "node scripts/build-publication-edition.mjs",
    "publication:verify": "node scripts/verify-publication-edition.mjs",
    "publication:check-live": "node scripts/check-publication-source-parity.mjs",
    "publication:attest": "node scripts/check-publication-source-parity.mjs --write-attestation",
    "publication:import-land-divided": "python -X utf8 scripts/import-a-land-divided.py",
    "publication:publish-land-divided": "node scripts/publish-a-land-divided.mjs",
    "gold-cleaner": "node tools/gold-cleaner/server.mjs",
    "enrich-books": "node scripts/enrich-books.mjs",
    "sync-books": "node scripts/enrich-books.mjs",
    "supabase:seed": "node scripts/export-supabase-seed.mjs",
    "supabase:backfill-content": "node scripts/backfill-book-content-live.mjs",
    "supabase:upload-covers": "node scripts/upload-covers-to-supabase.mjs",
    "print:paperback": "node scripts/generate-paperback.mjs",
    "print:legal-proofs": "node scripts/generate-101-print-proof.mjs --legal-proofs-only",
    "print:disclaimers": "node scripts/audit-print-disclaimers.mjs",
    "print:set-assets": "node scripts/set-print-product-assets.mjs",
    "print:upload": "node scripts/upload-paperbacks-to-supabase.mjs",
    "audio:manifest": "node scripts/build-audio-track-manifest.mjs",
    "audio:ingest:tacos": "node scripts/ingest-tacos-audio-pilot.mjs",
    "arena:discover-wikimedia": "node scripts/arena-discover-wikimedia.mjs",
    "arena:import-wikimedia": "node scripts/arena-import-wikimedia.mjs",
    "arena:promote-candidate": "node scripts/arena-promote-candidate.mjs",
    "arena:propose-svg-targets": "node scripts/arena-propose-svg-targets.mjs",
    "arena:propose-vision-targets": "node scripts/arena-propose-vision-targets.mjs",
    "arena:stage-preview": "node scripts/arena-stage-preview-pack.mjs",
    "arena:rank-candidates": "node scripts/arena-rank-candidates-local.mjs",
    "arena:plan-pack": "node scripts/arena-plan-pack.mjs",
    "arena:qa-house-plate": "node scripts/arena-qa-house-plate.mjs",
    "atlas:seed": "node atlas/scripts/seed_foundations.js",
    "atlas:validate": "node atlas/scripts/validate_nodes.js",
    "atlas:index": "node atlas/scripts/build_indexes.js",
    "atlas:detect-duplicates": "node atlas/scripts/detect_duplicates.js",
    "atlas:detect-broken-links": "node atlas/scripts/detect_broken_links.js",
    "atlas:detect-cycles": "node atlas/scripts/detect_cycles.js",
    "atlas:check": "npm run atlas:validate && npm run atlas:detect-duplicates && npm run atlas:detect-broken-links && npm run atlas:detect-cycles",
    "atlas:import-maps": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-atlas-map-spec.mjs",
    "atlas:generate-draft": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-atlas-draft.mjs",
    "atlas:generate-from-sources": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-atlas-draft-from-sources.mjs",
    "atlas:generate-with-model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-atlas-draft-with-model.mjs",
    "atlas:generate-staged": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-atlas-draft-staged.mjs",
    "atlas:ingest-sources": "node scripts/ingest-atlas-sources.mjs",
    "atlas:inventory:build": "node atlas/scripts/build_inventory.js",
    "atlas:inventory:normalize": "node atlas/scripts/normalize_inventory.js",
    "atlas:inventory:validate": "node atlas/scripts/validate_inventory.js",
    "atlas:inventory:duplicates": "node atlas/scripts/detect_inventory_duplicates.js",
    "atlas:inventory:promote": "node atlas/scripts/promote_inventory_nodes.js",
    "atlas:inventory": "npm run atlas:inventory:build && npm run atlas:inventory:normalize && npm run atlas:inventory:validate && npm run atlas:inventory:duplicates"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "^5.2.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.2.5",
    "@fontsource-variable/literata": "^5.2.5",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
