{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jju.local/atlas/schema/inventory.schema.json",
  "title": "Atlas Term Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "title",
    "generatedAt",
    "target",
    "sources",
    "terms"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "target": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "domain",
          "subdomains",
          "aliases",
          "sourceNames",
          "sourceUrls",
          "status",
          "promoted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "subdomains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "review",
              "rejected",
              "promoted"
            ]
          },
          "promoted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
