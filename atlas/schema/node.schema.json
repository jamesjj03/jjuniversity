{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jju.local/atlas/schema/node.schema.json",
  "title": "Atlas Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "domains",
    "subdomains",
    "summary",
    "prerequisites",
    "unlocks",
    "related",
    "aliases",
    "tags",
    "sources",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "foundation",
        "concept",
        "object",
        "process",
        "theory",
        "person",
        "event",
        "place",
        "tool",
        "text",
        "institution"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "subdomains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wikipedia",
        "britannica",
        "openstax",
        "stanford_encyclopedia"
      ],
      "properties": {
        "wikipedia": {
          "type": "string"
        },
        "britannica": {
          "type": "string"
        },
        "openstax": {
          "type": "string"
        },
        "stanford_encyclopedia": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "reviewed",
        "published"
      ]
    }
  }
}
