{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jjuniversity.com/schemas/atlas/portrait-pilot.v1.schema.json",
  "title": "JJU Atlas bounded portrait pilot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "purpose", "people", "media", "bindings"],
  "properties": {
    "schemaVersion": { "const": "1.2.0" },
    "reviewedAt": { "$ref": "#/$defs/date" },
    "purpose": { "type": "string", "minLength": 30 },
    "people": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/person" } },
    "media": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/media" } },
    "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "personId": { "type": "string", "pattern": "^person:[a-z0-9][a-z0-9-]*$" },
    "mediaId": { "type": "string", "pattern": "^media:[a-z0-9][a-z0-9-]*$" },
    "countryId": { "type": "string", "pattern": "^country:[A-Z0-9]{3}$" },
    "officeId": { "type": "string", "pattern": "^office:country:[A-Z0-9]{3}:head-of-(state|government)$" },
    "role": { "enum": ["headOfState", "headOfGovernment"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "portraitMediaId"],
      "properties": {
        "id": { "$ref": "#/$defs/personId" },
        "name": { "type": "string", "minLength": 2 },
        "portraitMediaId": { "$ref": "#/$defs/mediaId" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "personId", "href", "width", "height", "sourceWidth", "sourceHeight", "derivation", "author", "licenseName", "licenseUrl", "attributionStatement", "changes", "photoDate", "sourceUrl", "sourceCreditHtml", "inputUrl", "sourceSha256", "outputSha256", "bytes", "reviewedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/mediaId" },
        "personId": { "$ref": "#/$defs/personId" },
        "href": { "type": "string", "pattern": "^/atlas/portraits/[a-z0-9-]+\\.webp$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sourceWidth": { "type": "integer", "minimum": 1 },
        "sourceHeight": { "type": "integer", "minimum": 1 },
        "derivation": { "type": "string", "minLength": 10 },
        "author": { "type": "string", "minLength": 2 },
        "licenseName": { "type": "string", "minLength": 2 },
        "licenseUrl": { "type": "string", "pattern": "^https://" },
        "attributionStatement": { "type": ["string", "null"] },
        "changes": { "type": "string", "minLength": 10 },
        "photoDate": { "$ref": "#/$defs/date" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "sourceCreditHtml": { "type": ["string", "null"] },
        "inputUrl": { "type": "string", "pattern": "^https://" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "reviewedAt": { "$ref": "#/$defs/date" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officeId", "entityId", "role", "personId", "title", "exactSourceName", "sourceId", "observedAt", "identityConfidence", "reviewedAt"],
      "properties": {
        "officeId": { "$ref": "#/$defs/officeId" },
        "entityId": { "$ref": "#/$defs/countryId" },
        "role": { "$ref": "#/$defs/role" },
        "personId": { "$ref": "#/$defs/personId" },
        "title": { "type": "string", "minLength": 2 },
        "exactSourceName": { "type": "string", "minLength": 3 },
        "sourceId": { "type": "string", "minLength": 3 },
        "observedAt": { "$ref": "#/$defs/date" },
        "identityConfidence": { "$ref": "#/$defs/confidence" },
        "reviewedAt": { "$ref": "#/$defs/date" }
      }
    }
  }
}
