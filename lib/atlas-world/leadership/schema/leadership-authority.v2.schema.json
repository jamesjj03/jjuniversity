{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jjuniversity.com/schemas/atlas/leadership-authority.v2.schema.json",
  "title": "JJU Atlas leadership authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorityId", "revision", "reviewedAt", "purpose", "policy", "reviewPolicy", "people", "offices", "contexts", "officeUpdates"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "authorityId": { "const": "jju-atlas-leadership" },
    "revision": { "type": "string", "minLength": 1 },
    "reviewedAt": { "$ref": "#/$defs/date" },
    "purpose": { "type": "string", "minLength": 30 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticPublication", "freshnessDoesNotAssertCurrentOffice", "separatePersonOfficeAndPolityIdentity", "unreviewedPortraitBehavior"],
      "properties": {
        "automaticPublication": { "const": false },
        "freshnessDoesNotAssertCurrentOffice": { "const": true },
        "separatePersonOfficeAndPolityIdentity": { "const": true },
        "unreviewedPortraitBehavior": { "const": "no_portrait" }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewAfterDays", "description"],
      "properties": {
        "reviewAfterDays": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 30 }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/person" }
    },
    "offices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/office" }
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "officeUpdates": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "personId": { "type": "string", "pattern": "^person:[a-z0-9][a-z0-9-]*$" },
    "countryId": { "type": "string", "pattern": "^country:[A-Z0-9]{3}$" },
    "officeId": { "type": "string", "pattern": "^office:country:[A-Z0-9]{3}:head-of-(state|government)$" },
    "role": { "enum": ["headOfState", "headOfGovernment"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "url", "publishedAt"],
      "properties": {
        "publisher": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "pattern": "^https://" },
        "publishedAt": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalName", "aliases", "identityConfidence", "reviewedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/personId" },
        "canonicalName": { "type": "string", "minLength": 2 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "identityConfidence": { "$ref": "#/$defs/confidence" },
        "reviewedAt": { "$ref": "#/$defs/date" }
      }
    },
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polityEntityId", "role", "label", "holderModel"],
      "properties": {
        "id": { "$ref": "#/$defs/officeId" },
        "polityEntityId": { "$ref": "#/$defs/countryId" },
        "role": { "$ref": "#/$defs/role" },
        "label": { "type": "string", "minLength": 3 },
        "holderModel": { "enum": ["individual", "collective", "variable", "unspecified"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "entityId", "roles", "officeIds", "exactSourceName", "archivedObservedAt", "sourceId", "summary", "sources"],
      "properties": {
        "personId": { "$ref": "#/$defs/personId" },
        "entityId": { "$ref": "#/$defs/countryId" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
        "officeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/officeId" } },
        "exactSourceName": { "type": "string", "minLength": 3 },
        "archivedObservedAt": { "$ref": "#/$defs/date" },
        "sourceId": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 30 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "officeId", "entityId", "role", "personId", "personName", "title", "termStartedAt", "observedAt", "reviewAfter", "occupancyStatus", "confidence", "status", "supersedes", "summary", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^office-observation:" },
        "officeId": { "$ref": "#/$defs/officeId" },
        "entityId": { "$ref": "#/$defs/countryId" },
        "role": { "$ref": "#/$defs/role" },
        "personId": { "$ref": "#/$defs/personId" },
        "personName": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 2 },
        "termStartedAt": { "$ref": "#/$defs/date" },
        "observedAt": { "$ref": "#/$defs/date" },
        "reviewAfter": { "$ref": "#/$defs/date" },
        "occupancyStatus": { "enum": ["occupied", "vacant", "collective", "uncertain"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "status": { "const": "reviewed_source_observation" },
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["personId", "exactSourceName", "sourceId", "observedAt", "termEndedAt"],
          "properties": {
            "personId": { "$ref": "#/$defs/personId" },
            "exactSourceName": { "type": "string", "minLength": 3 },
            "sourceId": { "type": "string", "minLength": 3 },
            "observedAt": { "$ref": "#/$defs/date" },
            "termEndedAt": { "$ref": "#/$defs/date" }
          }
        },
        "summary": { "type": "string", "minLength": 30 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}
