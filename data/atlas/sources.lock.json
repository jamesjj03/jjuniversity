{
  "schemaVersion": "1.0.0",
  "lockId": "jju-atlas-sources-2026-09-05",
  "cacheDirectory": "data/atlas/source-cache",
  "builds": [
    {
      "id": "atlas-world-snapshot-v1",
      "command": "npm run atlas:world:build",
      "code": "scripts/build-atlas-world-snapshot.mjs",
      "sourceIds": [
        "natural-earth-admin-0-50m-5.1.2",
        "world-bank-country-metadata-2026-09-03",
        "world-bank-sp-pop-totl-2026-07-13",
        "world-bank-ny-gdp-mktp-cd-2026-07-13",
        "world-bank-ny-gdp-pcap-cd-2026-07-13",
        "world-bank-sp-urb-totl-in-zs-2026-07-13",
        "world-bank-sp-pop-grow-2026-07-13",
        "world-bank-sp-pop-0014-to-zs-2026-07-13",
        "world-bank-sp-pop-65up-to-zs-2026-07-13",
        "world-bank-sp-dyn-tfrt-in-2026-07-13",
        "world-bank-sp-dyn-le00-in-2026-07-13",
        "geonames-country-info-2026-09-03",
        "cia-world-factbook-final-capture-2026-02"
      ],
      "transformations": [
        "Join datasets through reviewed geographic codes rather than names.",
        "Normalize government and broad religious categories with versioned rules while retaining source wording.",
        "Retain the latest non-empty World Bank observation and its own year for each approved How People Live indicator; preserve missing entities rather than imputing values.",
        "Project canonical Natural Earth WGS84 geometry into a 1200 x 650 Mercator SVG viewBox."
      ],
      "outputs": [
        "lib/atlas-world/data/countries.v1.json",
        "lib/atlas-world/data/geometry-mercator.v1.json",
        "lib/atlas-world/data/validation.v1.json",
        "public/atlas-world/geometry-mercator.v1.svg"
      ]
    },
    {
      "id": "atlas-globe-geometry-v1",
      "command": "npm run atlas:globe:geometry",
      "code": "scripts/build-atlas-globe-geometry.mjs",
      "sourceIds": [
        "natural-earth-admin-0-50m-5.1.2"
      ],
      "transformations": [
        "Retain canonical Natural Earth WGS84 Polygon and MultiPolygon coordinates, strip unrelated source properties, and join every feature to the existing Atlas entity ID through ADM0_A3.",
        "Retain source label coordinates and tiny-map-unit ranks for bounded screen-space selection assistance without changing political geometry."
      ],
      "outputs": [
        "public/atlas-world/geometry-wgs84.v1.json"
      ]
    },
    {
      "id": "atlas-geography-pack-v1",
      "command": "npm run atlas:geography:build",
      "code": "scripts/build-atlas-geography-pack.py",
      "runner": "scripts/run-atlas-geography-build.mjs",
      "requirements": {
        "path": "scripts/atlas-geography-requirements.txt",
        "python": "3.11",
        "normalizedTextChecksumSha256": "08f0a3dd4b313384e1370bc40fad1b50b076e57b4e7bedd21ba1c72cb8c712b5"
      },
      "vectorOnlyRequirements": {
        "path": "scripts/atlas-vector-requirements.txt",
        "python": "3.11-3.14",
        "normalizedTextChecksumSha256": "27eb6205304c39a021fcd830ed2c5d7e8c44aae05358c6f999bb88da7d02afdc"
      },
      "sourceIds": [
        "ghsl-ghs-pop-2025-r2023a-1km",
        "natural-earth-manual-shaded-relief-50m-3.3.0",
        "natural-earth-rivers-50m-5.1.2",
        "natural-earth-lakes-50m-5.1.2",
        "natural-earth-rivers-10m-5.1.2",
        "natural-earth-lakes-10m-5.1.2",
        "natural-earth-populated-places-10m-5.1.2",
        "natural-earth-admin-0-50m-5.1.2",
        "natural-earth-marine-areas-10m-5.1.2",
        "world-bank-major-river-basins-2019",
        "wikidata-major-river-pilot-2026-09-05",
        "wikidata-major-river-linked-labels-2026-09-05"
      ],
      "transformations": [
        "Area-average the original 1 km World Mollweide population-count grid independently into a 2400 x 1300 Mercator overview and tiled 19200 x 10400 / 38400 x 20800 / 76800 x 41600 detail levels, then apply the same recorded log1p palette and sphere mask. Never upscale the overview.",
        "Bilinear-warp the Natural Earth WGS84 grayscale relief into the same Mercator raster and sphere mask while preserving the source-authored grayscale without synthetic contrast, sharpening, or embossing.",
        "Select and round-trip canonical WGS84 vectors, then derive 1200 x 650 Mercator SVG paths and points.",
        "Retain 50m world/regional rivers and lakes, add 10m close-scale rivers with min_zoom <= 7 and lakes with min_zoom <= 5 after removing empty/duplicate geometry, and all national capitals plus 10m cities with SCALERANK <= 4. Preserve source identities and add conservative logical place identities for named physical features.",
        "Derive river and lake relationships to current Atlas Admin-0 map units by WGS84 geometry intersection against the pinned Natural Earth Admin-0 source; these are map-intersection observations, not claims about complete drainage basins or political ownership.",
        "Convert Natural Earth Populated Places POP2025 values from the source's thousands-of-people unit into integer people while retaining estimated status and the original field name in provenance.",
        "Select named Natural Earth marine polygons in globally and regionally meaningful ocean, sea, gulf, bay, strait, and channel classes at source scale rank 4 or better; group multipart waters by stable Wikidata identity when available, derive label anchors, and describe neighboring Admin-0 units only as coastline adjacency to mapped geometry.",
        "Extract a five-basin pilot from the World Bank Major River Basins shapefile, union the two Amazon source polygons, preserve canonical WGS84 geometry and raw basin IDs, and derive Mercator display geometry without inferring ownership.",
        "Attach a bounded five-river fact authority from pinned Wikidata CC0 entity statements, preserving selected statement IDs, value caveats, and source definitions; omit discharge because location and measurement qualifiers are not comparable across the pilot.",
        "Emit a compact WGS84 globe-context asset containing only world-scale river lines, high-priority city points, and bounded major-water label points from the same locked geography sources."
      ],
      "outputs": [
        "lib/atlas-world/data/geography-pack.v1.json",
        "public/atlas-world/layers/population-density-2025.mercator.webp",
        "public/atlas-world/layers/population-density-2025-mercator/regional/",
        "public/atlas-world/layers/population-density-2025-mercator/country/",
        "public/atlas-world/layers/physical-relief.mercator.webp",
        "public/atlas-world/physical-relief-mercator/source-detail/",
        "public/atlas-world/layers/population-density-2025-mercator/close/",
        "public/atlas-world/physical-mercator-overview.v1.svg",
        "public/atlas-world/physical-mercator-detail.v1.svg",
        "public/atlas-world/water-mercator.v1.svg",
        "public/atlas-world/watersheds-mercator.v1.svg",
        "public/atlas-world/globe-context.v1.json",
        "lib/atlas-world/data/pattern-notes.v1.json"
      ]
    },
    {
      "id": "atlas-admin1-pilot-v1",
      "command": "npm run atlas:admin1:build",
      "code": "scripts/build-atlas-admin1-pilot.mjs",
      "sourceIds": [
        "natural-earth-admin-1-10m-repository-5.1.2",
        "us-census-population-estimates-2024-admin1"
      ],
      "transformations": [
        "Select first-order units for Canada, China, Germany, India, Nigeria, and the United States using ADM0_A3 plus a standard-shaped ISO 3166-2 code and GADM_LEVEL 1.",
        "Preserve selected source geometry as canonical WGS84 GeoJSON and derive a separate 1200 x 650 Mercator SVG asset.",
        "Join the official U.S. Census Bureau Vintage 2024 state population estimates to the 50 states and District of Columbia through Natural Earth FIPS codes; do not infer values for the other pilot countries.",
        "Exclude the Paracel Islands source feature because Natural Earth classifies it at GADM level 0 and supplies a non-standard provisional code."
      ],
      "outputs": [
        "data/atlas/derived/admin1-pilot-wgs84.v1.geojson",
        "lib/atlas-world/data/admin1-pilot.v1.json",
        "public/atlas-world/admin1-pilot-mercator.v1.svg"
      ]
    }
  ],
  "notes": [
    "Every generated Atlas artifact must name a source entry from this lock.",
    "HTTP downloads are accepted only when both byte length and SHA-256 match.",
    "The eleven small mutable World Bank and GeoNames API snapshots are embedded under data/atlas/source-seeds so a future upstream update cannot change a preserved build.",
    "The Factbook source is pinned to a Git commit and verified with the same deterministic file-set hash used by the Atlas snapshot builder.",
    "Large raw inputs stay out of Git; bounded browser-ready derivatives are committed."
  ],
